# File system
alias ls='eza -lh --group-directories-first --icons=auto'
alias l='ls'
alias lsa='ls -a'
alias lt='eza --tree --level=2 --long --icons --git'
alias lta='lt -a'
alias ff="fzf --preview 'bat --style=numbers --color=always {}'"
alias cd="zd"
zd() {
  if [ $# -eq 0 ]; then
    builtin cd ~ && return
  elif [ -d "$1" ]; then
    builtin cd "$1"
  else
    z "$@" && printf "\U000F17A9 " && pwd || echo "Error: Directory not found"
  fi
}
open() {
  xdg-open "$@" >/dev/null 2>&1 &
}

# Directories
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# Tools
alias d='docker'
alias r='rails'
n() { if [ "$#" -eq 0 ]; then nvim .; else nvim "$@"; fi; }

alias vi='nvim'
alias vim='nvim'
alias vimdiff='nvim -d'

# Git
alias g='git'
alias gcm='git commit -m'
alias gcam='git commit -a -m'
alias gcad='git commit -a --amend'

# Build-related
CORES=`nproc`

alias m="make -j$CORES V=1 VERBOSE=1 ARGS='-j$CORES'"
alias mm="make -j$CORES V=1 VERBOSE=1 && make install -j$CORES"
alias mmm="make clean -j$CORES V=1 VERBOSE=1"
alias c="cargo b --release && cargo b"
alias cl="cargo clean"
alias ct="cargo nextest run"

# Misc
alias rf="readlink -f"
alias gg="git grep"
alias gg5="git grep -A5 -B5"
alias val="valgrind --leak-check=yes --trace-children=yes"
alias gbr="git for-each-ref --sort=-committerdate refs/heads/ | head -n40"
alias gbrall="git for-each-ref --sort=-committerdate refs/heads/"
